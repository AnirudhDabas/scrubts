{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubts.dev/schemas/proof-0.1.schema.json",
  "title": "scrub proof result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_revision", "tested_source", "result", "claims", "source_identities", "fixture_identities", "gate_results", "report_digests", "limitations"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "project_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tested_source": { "$ref": "#/$defs/tested_source" },
    "result": { "enum": ["PROOF_COMPLETE", "PROOF_FAILED"] },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_result" }
    },
    "source_identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_identity" }
    },
    "fixture_identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture_identity" }
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate_result" }
    },
    "report_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/report_digest" }
    },
    "limitations": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "claim_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_status", "gate_status"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "claim_status": { "enum": ["established", "unknown"] },
        "gate_status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" }
      }
    },
    "fixture_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "claim_ids", "status", "command", "expected_result", "evidence_artifacts", "limitations", "reason"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "status": { "enum": ["PASS", "FAIL"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expected_result": { "type": "string", "minLength": 1 },
        "evidence_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "limitations": { "$ref": "#/$defs/strings" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "report_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "report_sha256", "scope"],
      "properties": {
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scope": { "const": "local_repeatability_only" }
      }
    }
  ,
    "tested_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "base_revision", "staged", "scope", "identity_sha256", "paths"],
      "properties": {
        "state": { "enum": ["clean", "dirty"] },
        "base_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "staged": { "type": "boolean" },
        "scope": { "const": "proof_relevant_project" },
        "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "index_object", "worktree_sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 2, "maxLength": 2 },
              "index_object": { "type": ["string", "null"] },
              "worktree_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
  ,
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "PROOF_COMPLETE" } }, "required": ["result"] },
      "then": { "properties": { "gate_results": { "items": { "properties": { "status": { "const": "PASS" } } } } } }
    }
  ]
}
