{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrub.ts/schemas/determinism-platform-0.1.schema.json",
  "title": "scrub platform semantic-digest result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_revision", "platform", "fixtures"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platform": {"enum": ["windows", "linux", "macos"]},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "input_sha256", "expected_capability", "semantic_report_sha256"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_capability": {"type": "string", "minLength": 1},
          "semantic_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
