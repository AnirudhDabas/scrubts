{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubts.dev/schemas/waterlarp/experiment-manifest-2.0.0.json",
  "title": "WaterLARP canonical experiment manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "experiment_id", "experiment_spec_id", "run_id",
    "artifact_set_id", "created_by_tool_version", "git_commit", "git_dirty",
    "git_diff_sha256", "environment", "model_repo", "model_revision",
    "model_artifact_hashes", "tokenizer_repo", "tokenizer_revision",
    "tokenizer_artifact_hashes", "sample_sets", "sample_set_sha256",
    "watermark_config", "authority_record", "generation_config",
    "detector_config", "calibration_policy", "evidence_length_policy",
    "threshold_records", "transform_config", "search_config", "rng_seeds",
    "environment_lock_sha256", "source_ledger_sha256", "checkpoint",
    "scientific_artifact_sha256", "experiment_specification"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "experiment_spec_id": {"type": "string", "pattern": "^wlrs1-[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^wlrp1-[0-9a-f]{24}$"},
    "artifact_set_id": {"type": "string", "pattern": "^wlra1-[0-9a-f]{24}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sample_set_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_specification": {
      "type": "object",
      "required": [
        "sample_sets", "evaluation_lengths", "model", "tokenizer", "generation_config", "schemes",
        "calibration_policy", "evidence_length_policy", "transform_config",
        "mixed_authorship", "search_config", "source_authorities",
        "environment_lock_sha256", "master_seed"
      ],
      "properties": {
        "evaluation_lengths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "sample_sets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/taskSampleSet"}
    },
    "threshold_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/thresholdRecord"}
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "path", "payload_sha256", "file_sha256", "experiment_spec_id",
        "sample_set_sha256", "model_identity_sha256", "tokenizer_identity_sha256",
        "generation_config_sha256"
      ],
      "properties": {
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scientific_artifact_sha256": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampleMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "row_index", "row_sha256"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "row_index": {"type": "integer", "minimum": 0},
        "row_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "taskSampleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset", "dataset_revision", "source_split", "prompt_template_sha256", "splits"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "dataset_revision": {"type": "string", "minLength": 1},
        "source_split": {"type": "string", "minLength": 1},
        "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "calibration", "test"],
          "properties": {
            "generation": {"$ref": "#/$defs/memberArray"},
            "calibration": {"$ref": "#/$defs/memberArray"},
            "test": {"$ref": "#/$defs/memberArray"}
          }
        }
      }
    },
    "memberArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sampleMember"}
    },
    "thresholdRecord": {
      "type": "object",
      "required": [
        "threshold_id", "context", "threshold", "target_fpr", "negative_count",
        "maximum_allowed_false_positives", "false_positive_count",
        "empirical_calibration_exceedance", "resolution_status",
        "calibration_sample_ids", "calibration_scores_sha256"
      ],
      "properties": {
        "threshold_id": {"type": "string", "pattern": "^wlrt1-[0-9a-f]{24}$"},
        "target_fpr": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "negative_count": {"type": "integer", "minimum": 1},
        "false_positive_count": {"type": "integer", "minimum": 0},
        "resolution_status": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "calibration_sample_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "calibration_scores_sha256": {"$ref": "#/$defs/sha256"},
        "context": {
          "type": "object",
          "required": [
            "scheme", "mechanism_version", "detector_config_sha256", "model_revision",
            "tokenizer_revision", "task", "key_policy", "threshold_semantics",
            "evidence_length_policy", "scored_unit_count", "regime", "operation",
            "operation_strength", "search_spec_sha256", "comparator",
            "comparator_authority"
          ],
          "properties": {
            "scored_unit_count": {"type": "integer", "minimum": 1},
            "comparator": {"enum": [">", ">="]},
            "threshold_semantics": {
              "enum": ["fixed_clean_threshold", "operation_conditioned_threshold"]
            }
          }
        }
      }
    }
  }
}
