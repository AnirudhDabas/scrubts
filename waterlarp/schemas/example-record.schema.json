{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrubts.dev/schemas/waterlarp/example-record-2.0.0.json",
  "title": "WaterLARP per-example canonical record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "evaluation_id", "run_id", "sample_id", "source_split",
    "task", "scheme", "label", "evaluation_kind", "nominal_generation_length",
    "observed_token_length", "evidence_length", "entropy", "threshold_semantics",
    "threshold_id", "threshold", "comparator", "score", "p_value", "decision",
    "decision_status", "threshold_selection_status", "threshold_selection_reason",
    "transform", "transform_strength", "marked_fraction", "layout", "search_spec_id",
    "threat_model", "quality", "input_sha256", "output_sha256", "detector_evidence",
    "localization", "segments"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "evaluation_id": {"type": "string", "pattern": "^wlre1-[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^wlrp1-[0-9a-f]{24}$"},
    "label": {"enum": ["watermarked", "unwatermarked", "natural-secondary"]},
    "source_split": {"const": "test"},
    "threshold_semantics": {
      "enum": ["fixed_clean_threshold", "operation_conditioned_threshold"]
    },
    "decision": {"type": ["boolean", "null"]},
    "decision_status": {
      "enum": ["DETECTED", "NOT_DETECTED", "UNRESOLVED", "UNSUPPORTED"]
    },
    "nominal_generation_length": {"type": "integer", "minimum": 1},
    "observed_token_length": {"type": "integer", "minimum": 0},
    "evidence_length": {"type": "integer", "minimum": 0},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "detector_evidence": {"$ref": "#/$defs/detectorEvidence"},
    "localization": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/localization"}]
    },
    "segments": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"$ref": "#/$defs/segment"}}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "label": {"const": "watermarked"},
          "evaluation_kind": {"pattern": "^mixed_document_"}
        },
        "required": ["label", "evaluation_kind"]
      },
      "then": {
        "properties": {
          "localization": {"$ref": "#/$defs/localization"},
          "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"type": "null"}}, "required": ["decision"]},
      "then": {"properties": {"decision_status": {"enum": ["UNRESOLVED", "UNSUPPORTED"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "marked", "source_id", "coordinate_system"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "marked": {"type": "boolean"},
        "source_id": {"type": "string", "minLength": 1},
        "coordinate_system": {"const": "TOKEN"}
      }
    },
    "localization": {
      "type": "object", "additionalProperties": false,
      "required": [
        "coordinate_system", "marked_span_definition", "marked_spans", "predicted_span",
        "overlap_token_count", "union_token_count", "iou", "start_offset_error",
        "end_offset_error"
      ],
      "properties": {
        "coordinate_system": {"const": "TOKEN"},
        "marked_span_definition": {"type": "string", "minLength": 1},
        "marked_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "predicted_span": {"$ref": "#/$defs/span"},
        "iou": {"type": "number", "minimum": 0, "maximum": 1},
        "overlap_token_count": {"type": "integer", "minimum": 0},
        "union_token_count": {"type": "integer", "minimum": 0},
        "start_offset_error": {"type": "integer"},
        "end_offset_error": {"type": "integer"}
      }
    },
    "detectorEvidence": {
      "type": "object", "additionalProperties": true,
      "required": [
        "evidence_schema_version", "procedure", "detector_input_token_ids",
        "tokenizer_identity", "detector_config_identity", "detector_config",
        "key_provenance", "statistic_name", "raw_score", "p_value",
        "scored_unit_count", "raw_detector_evidence", "threshold_request_context",
        "threshold", "decision", "decision_status", "search_procedure"
      ],
      "properties": {
        "evidence_schema_version": {"const": "1.0.0"},
        "procedure": {"enum": ["TOKEN_SEQUENCE", "WINDOW_MAX"]},
        "detector_input_token_ids": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "detector_config_identity": {"$ref": "#/$defs/sha256"},
        "scored_unit_count": {"type": "integer", "minimum": 0},
        "decision": {"type": ["boolean", "null"]}
      }
    }
  }
}
